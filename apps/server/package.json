{
  "name": "@pm/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:shared && tsx watch src/index.ts",
    "build:shared": "tsc -p ../../packages/shared/tsconfig.json",
