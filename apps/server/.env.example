# ---- required in deployment ----
# Turso database URL, e.g. libsql://your-db-name.turso.io
TURSO_DATABASE_URL=
# Turso auth token (create with: turso db tokens create <db>)
TURSO_AUTH_TOKEN=
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- optional ----
# Base64 of the Firebase service-account JSON. Without it, push is disabled (desktop still works).
FCM_SERVICE_ACCOUNT_JSON=
# Code friends use to create an account. Each code admits one person; change it to mint a new one.
BOOTSTRAP_INVITE=FRIENDS2026
# Comma-separated extra codes seeded at startup. Defaults to "<BOOTSTRAP_INVITE>-2".
# BOOTSTRAP_INVITES=FRIENDS2026-2,FRIENDS2026-3
PORT=8787
# "production" hides dev warnings
NODE_ENV=development
